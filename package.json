{
  "name": "zaobian-scan-order",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "灶边小馆 · 扫码点餐 H5（Vue 3 + Vite）",
  "homepage": "https://zamp1e.github.io/scan-order-app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zamp1e/scan-order-app.git"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint . --ext .js,.vue --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .js,.vue --ignore-path .gitignore --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"*.{js,json,md}\"",
    "verify": "npm run check:data && npm run lint && npm run build",
    "check:data": "node scripts/self-check.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "pinia-plugin-persistedstate": "~4.2.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "playwright-core": "^1.49.1",
    "prettier": "^3.4.2",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
